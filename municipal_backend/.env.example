# Copy to .env and fill in. Never commit the filled-in copy.

NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=municipal_backend
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Outbound mail (SMTP over STARTTLS) ───────────────────────────────────────
# For Gmail, SMTP_PASSWORD must be a 16-character App Password, not the account
# password: https://myaccount.google.com/apppasswords
# Leave SMTP_HOST blank to run without a transport — mail is then printed to the
# server console instead of being sent, which is enough to follow the flow
# locally but sends nothing to the bidder.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=ProcureNance Procurement
MAIL_FROM_ADDRESS=

# Workflow requirement 4: between 24 and 48 hours.
ACTIVATION_TOKEN_TTL_HOURS=48

# Security requirement: short-lived one-time codes.
OTP_TTL_MINUTES=5
