{
  "name": "municipal_backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "xian-start": "node index.js",
    "xian": "nodemon index.js",
    "migrate": "node migrate.js",
    "seed": "node seed.js",
    "seed:demo": "node seedDemo.js",
    "seed:completed": "node seedDemo.js --completed-project",
    "reset:workflow": "node resetDemoData.js",
    "create:model": "node create.js model",
    "create:controller": "node create.js controller",
    "migrate:auth": "node migrateAuthSecurity.js",
    "migrate:planning-goal-sector": "node migratePlanningGoalSector.js",
    "test:security:unit": "node --test services/authPolicy.test.mjs services/totp.test.mjs",
    "test:security:integration": "node --test tests/authSecurity.integration.test.mjs",
    "cf:build": "npm run build --prefix ../municipal-frontend",
    "cf:dev": "npm run cf:build && wrangler dev --remote",
    "cf:deploy": "npm run security:check && npm run cf:build && wrangler deploy",
    "test:security": "node --test tests/security.test.mjs",
    "test:qa": "node --test tests/*.test.mjs",
    "security:check": "npm run test:security && npm audit --audit-level=moderate && npm audit --prefix ../municipal-frontend --audit-level=moderate && npm run lint --prefix ../municipal-frontend"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "inquirer": "^9.2.15",
    "multer": "^2.2.0",
    "mysql2": "^3.9.2",
    "nodemailer": "^9.0.3",
    "pg-hstore": "^2.3.4",
    "puppeteer-core": "^25.6.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "2.17.7",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "sequelize": {
      "uuid": "11.1.1"
    },
    "@cloudflare/puppeteer": {
      "@puppeteer/browsers": "3.2.2"
    }
  }
}
